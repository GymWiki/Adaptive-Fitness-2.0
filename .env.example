# Google OAuth 2.0 Client ID (Web application type) — not a secret, safe to
# ship client-side. From Google Cloud Console; Sheets API + Drive API must
# be enabled and this app's origins allow-listed on the client.
# Superseded by Firebase Auth below as of the Firebase migration (Phase 1) —
# kept until Phase 4 removes the Sheets/GIS layer entirely.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Firebase web app config — from Firebase Console > Project settings > your
# web app. Not secrets, safe to ship client-side; access is enforced by
# Firestore security rules, not by keeping these values private.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
