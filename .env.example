VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth 2.0 Client ID (Web application type) — not a secret, safe to
# ship client-side. From Google Cloud Console; Sheets API + Drive API must
# be enabled and this app's origins allow-listed on the client.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
